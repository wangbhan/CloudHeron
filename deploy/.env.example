# Copy to .env.docker at the repo root. Use unique secrets.
WEB_BIND=127.0.0.1
WEB_PORT=8800

# Dedicated PostgreSQL service on the Compose network.
# Use a URL-safe password or percent-encode the password in DATABASE_URL.
POSTGRES_USER=cloudheron
POSTGRES_DB=cloudheron
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://cloudheron:REPLACE_POSTGRES_PASSWORD@postgres:5432/cloudheron

# Base64 of exactly 32 random bytes. Keep the key when restoring a database.
VAULT_KEY_B64=REPLACE_VAULT_KEY

# Local SeaweedFS settings. For a cloud bucket, see the deployment guide.
S3_BUCKET=cloudheron-media
S3_REGION=us-east-1
S3_ACCESS_KEY=cloudheron-local
S3_SECRET_KEY=REPLACE_S3_SECRET
S3_ENDPOINT_URL=http://object-storage:8333
S3_LOCAL_PORT=59010
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:59010
S3_ADDRESSING_STYLE=path
S3_ALLOW_HTTP=true
S3_CREATE_BUCKET=false

COOKIE_SECURE=false
CORS_ORIGINS=[]
WORKERS=2
MAX_PENDING_PER_USER=10
