        "min": -2,
        "max": 2,
        "integer": false
      },
      {
        "key": "frequency_penalty",
        "label": "重复惩罚 frequency_penalty",
        "type": "number",
        "min": -2,
        "max": 2,
        "integer": false
      },
      {
        "key": "repetition_penalty",
        "label": "重复系数 repetition_penalty",
        "type": "number",
        "min": 0.01,
        "max": 10,
        "integer": false
      },
      {
        "key": "seed",
        "label": "文本随机种子",
        "type": "number",
        "min": -9007199254740991,
        "max": 9007199254740991,
        "integer": true
      },
      {
        "key": "stop",
        "label": "停止词（每行一个，最多 4 个）",
