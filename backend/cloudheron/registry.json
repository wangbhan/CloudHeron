        "type": "number",
        "min": 0,
        "max": 50,
        "integer": false
      },
      {
        "key": "num_inference_steps",
        "label": "采样步数",
        "type": "number",
        "min": 1,
        "max": 200,
        "integer": true
      }
    ],
    "text": [
      {
        "key": "temperature",
        "label": "温度 temperature",
        "type": "number",
        "min": 0,
        "max": 2,
        "integer": false
      },
      {
        "key": "top_p",
        "label": "概率采样 top_p",
        "type": "number",
        "min": 0,
        "max": 1,
        "integer": false
      },
      {
        "key": "top_k",
        "label": "候选数 top_k",
        "type": "number",
        "min": 1,
        "max": 1000,
        "integer": true
      },
      {
        "key": "max_tokens",
        "label": "最大输出 tokens",
        "type": "number",
        "min": 1,
        "max": 131072,
        "integer": true
      },
      {
        "key": "presence_penalty",
        "label": "主题惩罚 presence_penalty",
