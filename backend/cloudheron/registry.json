{
  "task_options": {
    "image": [
      {
        "key": "n",
        "label": "图片数量",
        "type": "number",
        "min": 1,
        "max": 4,
        "integer": true
      },
      {
        "key": "quality",
        "label": "质量",
        "type": "select",
        "values": [
          "auto",
          "standard",
          "hd",
          "low",
          "medium",
          "high"
        ]
      },
      {
        "key": "style",
        "label": "画面风格",
        "type": "select",
        "values": [
          "vivid",
          "natural"
        ]
      },
      {
        "key": "background",
        "label": "背景",
        "type": "select",
        "values": [
          "auto",
          "opaque",
          "transparent"
        ]
      },
      {
        "key": "output_format",
        "label": "输出格式",
        "type": "select",
        "values": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      {
        "key": "output_compression",
        "label": "输出压缩质量",
        "type": "number",
        "min": 0,
        "max": 100,
        "integer": true
      },
      {
        "key": "response_format",
        "label": "响应格式",
        "type": "select",
        "values": [
          "b64_json",
          "url"
        ]
      },
      {
        "key": "negative_prompt",
        "label": "负向提示词",
        "type": "string",
        "maxLength": 4000
      },
      {
        "key": "guidance_scale",
        "label": "引导强度 guidance_scale",
        "type": "number",
        "min": 0,
        "max": 50,
        "integer": false
      },
      {
        "key": "num_inference_steps",
        "label": "采样步数",
        "type": "number",
        "min": 1,
        "max": 200,
        "integer": true
      }
    ],
    "video": [
      {
        "key": "fps",
        "label": "帧率 fps",
        "type": "number",
        "min": 1,
        "max": 120,
        "integer": true
      },
      {
        "key": "aspect_ratio",
        "label": "宽高比 aspect_ratio",
        "type": "string",
        "maxLength": 40
      },
      {
        "key": "negative_prompt",
        "label": "负向提示词",
        "type": "string",
