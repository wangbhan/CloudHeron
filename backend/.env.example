# Copy to .env and replace placeholders. Do not commit .env.
DATABASE_URL=postgresql://cloudheron:REPLACE_PASSWORD@127.0.0.1:5432/cloudheron
VAULT_KEY_B64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
S3_BUCKET=REPLACE_PRIVATE_BUCKET
S3_REGION=us-east-1
# AWS S3: omit endpoint; other S3-compatible vendors: set HTTPS endpoint.
S3_ENDPOINT_URL=https://REPLACE_S3_ENDPOINT
S3_ACCESS_KEY=REPLACE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_SECRET_KEY
S3_ADDRESSING_STYLE=path
S3_ALLOW_HTTP=false
S3_CREATE_BUCKET=false
S3_DISABLE_EXPECT=false
COOKIE_SECURE=true
CORS_ORIGINS=[]
WORKERS=2
MAX_PENDING_PER_USER=10
